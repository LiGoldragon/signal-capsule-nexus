Signal
[]                                                    ; imports
[ Create.Workspace                                    ; inputs: one request per connection
  Start.{ Pane Command Label }
  Prompt.{ Pane Text }
  Press.{ Pane Keys }
  Close.Pane
  List.Session
  Subscribe.Session ]
[ Created.Outcome                                     ; outputs: every request receives one answer
  Started.Outcome
  Prompted.Outcome
  Pressed.Outcome
  Closed.Outcome
  Listed.Outcome
  Subscribed.Stream<Panes Known>                      ; the session's live panes, then each pane that moved
  SubscribeRefused.Outcome ]                          ; the refusal a Subscribe is answered with once
[ Session.String                                      ; types
  InstanceId.String
  Sequence.Integer
  CreationId.{ InstanceId Sequence }
  PaneId.String
  Pane.{ Session PaneId }
  Root.String
  Name.String
  Value.String
  Variable.{ Name Value }
  Workspace.{ Session Root ⟦ Variable ⟧ }
  AgentName.String
  AgentKind.[ Pi Claude Codex Gemini Cursor Devin Agy Cline Omp
              Mastracode Opencode Copilot Kimi Kiro Droid Amp Grok
              Hermes Kilo Qodercli Qwen Maki ]
  Program.String
  Executable.[ Configured Explicit.Program ]
  Command.{ AgentName AgentKind Executable ⟦ String ⟧ }
  Text.String
  Keys.⟦ String ⟧
  Label.String
  State.[ Open Busy Idle Dead ]
  Attempt.[ Settled Uncertain ]
  Known.{ Pane Option<Label> State Attempt }
  Panes.⟦ Known ⟧                                 ; a subscription's state: the panes not Dead
  ErrorCode.String
  ExitStatus.Integer
  Message.String
  SocketPath.String
  Refusal.{ ErrorCode Option<ExitStatus> Message }
  TransportRefusal.{ SocketPath Message }
  MemoryRefusal.Message
  ObservedEffect.[ Done
                   Created.Pane
                   Listed.⟦ Known ⟧ ]
  StorePhase.[ BeforeEmission
               Observed.ObservedEffect
               Uncertain ]
  StoreRefusal.{ MemoryRefusal StorePhase }
  Outcome.[ Done
            Created.Pane
            Listed.⟦ Known ⟧
            Refused.Refusal
            Unknown.Pane
            AttemptInProgress.Pane
            Unavailable.TransportRefusal
            Uncertain
            StoreRefused.StoreRefusal ] ]
